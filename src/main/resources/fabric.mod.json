{
	"schemaVersion": 1,
	"id": "visualmod",
	"version": "${version}",
	"name": "Visual Mod",
	"description": "Small, lightweight client-side visual improvements: glowing ores and dynamic light from held/dropped light sources.",
	"authors": [
		"Max Lettner"
	],
	"contact": {
		"sources": "https://github.com/maxlettner/visual-mod"
	},
	"license": "MIT",
	"environment": "client",
	"entrypoints": {
		"client": [
			"com.maxlettner.visualmod.VisualModClient"
		]
	},
	"mixins": [
		{
			"config": "visualmod.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.20.1",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	}
}
